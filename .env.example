# ── Server ────────────────────────────────────────────────
PORT=3000

# ── LLM ───────────────────────────────────────────────────
# Two API styles are supported; LLM_API_STYLE auto-detects from the base URL
# ("anthropic" in the URL → Anthropic Messages format, else OpenAI format).
#
# z.ai GLM via Anthropic-compatible endpoint (current setup):
LLM_BASE_URL=https://api.z.ai/api/anthropic
LLM_MODEL=glm-5.2
LLM_API_KEY=your-key-here
#
# Other options (uncomment and adjust):
#  OpenAI:        LLM_BASE_URL=https://api.openai.com/v1            LLM_MODEL=gpt-4o-mini
#  Groq (free):   LLM_BASE_URL=https://api.groq.com/openai/v1       LLM_MODEL=llama-3.3-70b-versatile
#  Gemini compat: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  LLM_MODEL=gemini-2.0-flash
#
# LLM_API_STYLE=openai | anthropic   (optional; auto-detected)

# Set true to run the UI with a scripted stand-in LLM (no key needed)
MOCK_LLM=false
